# SEED_DEMO_ACCOUNTS=true
# DEMO_PASSWORD=set-the-requested-demo-password
# ADMIN_PASSWORD=set-the-requested-admin-password
# LECTURER_PASSWORD=set-the-requested-lecturer-password
# CORS_ORIGINS=https://your-project.vercel.app
# Vercel only (not VITE_API_ORIGIN):
# API_ORIGIN=https://your-api.onrender.com
