{
  "name": "businesslife",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BUSINESSLIFE - a living Nigerian business simulation game (Lagos Life inspired)",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "api": "tsx server/index.ts",
    "seed": "tsx server/seed.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --import tsx --env-file=.env.test --test --test-concurrency=1 \"server/tests/**/*.test.ts\"",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "three": "^0.169.0",
    "zod": "^4.6.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": "22.x"
  }
}
